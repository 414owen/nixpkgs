diff --git a/libiberty/haskell-demangle.c b/libiberty/haskell-demangle.c
new file mode 100644
index 00000000000..50ccb9ada58
--- /dev/null
+++ b/libiberty/haskell-demangle.c
@@ -0,0 +1,359 @@
+/* Demangler for the Haskell programming language
+   Copyright (C) 2016-2024 Free Software Foundation, Inc.
+   Written by Owen Shepherd (owen@owen.cafe).
+
